{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/api/posts",
      "dest": "/api/posts.js"
    },
    {
      "src": "/api/contato",
      "dest": "/api/contato.js"
    },
    {
      "src": "/blog",
      "dest": "/blog.html"
    },
    {
      "src": "/post",
      "dest": "/post.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
